node_modules/
.env
*.log
.DS_Store

# 「触って分かる」サンプル(scripts/make-sample.sh が生成する使い捨て収録)。
# 先頭 / でリポジトリ直下の examples/ だけに限定する(docs/examples/ や
# schemas/examples/ の追跡対象を巻き込まないため)
/examples/

# 実装で用いたプランファイル
docs/plans/
docs/programs/

# Remotion Studio 用の一時ファイル置き場(動画は収録フォルダに置く)
public/

# scripts/engine-parity.mjs の生成物(比較グリッドPNG・esbuildバンドル・
# ffmpeg切り出し静止画。開発時の使い捨て。リポジトリ配布物ではない)
scripts/.parity-out/
scripts/.pixel-parity-out/

# swiftc が事前ビルドする OCR バイナリ(ソースは bin/ocr/vision-ocr.swift を追跡。
# 初回実行時に src/lib/ocr.ts が自動ビルドする)
bin/ocr/.build/

# swiftc が事前ビルドするカーソルヘルパバイナリ(ソースは
# src/lib/vendor/openscreen/OpenScreenMacOSCursorHelper/main.swift を追跡。
# 初回実行時に src/lib/cursorHelperBinary.ts が自動ビルドする)
src/lib/vendor/openscreen/OpenScreenMacOSCursorHelper/.build/

# swiftc が事前ビルドするディスプレイ列挙バイナリ(ソースは
# bin/displays/list-displays.swift を追跡。初回実行時に
# src/lib/displayList.ts が自動ビルドする)
bin/displays/.build/

# G1 画素ゲートの parity フィクスチャ(scripts/make-parity-fixture.sh が生成する
# 合成 raw.mp4・素材・manifest 等)。編集JSON(cutplan/transcript/overlays/shorts)
# だけをコミットする(golden の素になる入力)
test/fixtures/engine/parity-project/*
!test/fixtures/engine/parity-project/cutplan.json
!test/fixtures/engine/parity-project/transcript.json
!test/fixtures/engine/parity-project/overlays.json
!test/fixtures/engine/parity-project/shorts.json

# G1 画素ゲート本体(scripts/engine-pixel-gate.mjs)の実行ログ・差分グリッド出力
scripts/.pixel-gate-out/
# ゲート実行のたびに書く陳腐化検知用フィンガープリント(D6)。golden 本体
# (pixel-golden/*.png・provenance.json)はコミットするがこれは実行ごとの
# 生成物なのでコミットしない
test/fixtures/engine/pixel-golden/last-run.json
